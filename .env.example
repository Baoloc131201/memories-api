DB_URL=jdbc:postgresql://<host>/<db>?sslmode=require
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=<chuỗi ngẫu nhiên >= 32 ký tự>
# Đăng nhập mạng xã hội (tuỳ chọn)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Lưu ảnh: local (mặc định, thư mục ./uploads), db (trong PostgreSQL) hoặc r2 (Cloudflare R2)
STORAGE_TYPE=local
# Chỉ cần khi STORAGE_TYPE=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Chạy 1 lần với STORAGE_TYPE=db (hoặc r2) để chuyển ảnh cũ trong ./uploads sang
MIGRATE_LOCAL_UPLOADS=false
# Địa chỉ web FE (để tạo link đặt lại mật khẩu trong email)
APP_URL=http://localhost:5173
# Gửi email quên mật khẩu: dùng BREVO_API_KEY (khi deploy) hoặc SMTP. Để trống thì email chỉ in ra log
MAIL_FROM=
BREVO_API_KEY=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Khi deploy (HTTPS)
COOKIE_SECURE=false
CORS_ORIGINS=
